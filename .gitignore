# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# external downloaded repos
/awesome-design-md-main
/eslint-main
/react-native-main
/react-static-master
/superpowers-main
/transformers-main

# brand stock downloads (>9 GB, contains files >100MB blocked by GitHub)
/public/images/brand/*
!/public/images/brand/logo-horizontal.png
!/public/images/brand/NTL00354.JPG
