# ─── Database (Neon / Supabase / PostgreSQL) ───
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# ─── Payload CMS ───
PAYLOAD_DATABASE_URI=postgresql://user:password@host/neondb?sslmode=require
PAYLOAD_SECRET=super_secret_random_key_min_32_characters_long_for_payload
PAYLOAD_ADMIN_EMAIL=shivam@hasslefree-travels.com
PAYLOAD_ADMIN_PASSWORD=change_this_secure_admin_password_2026
NEXT_PUBLIC_SITE_URL=https://www.hasslefree-travels.com

# ─── Admin Authentication (/admin-legacy) ───
AUTH_SECRET=super_secret_random_key_min_32_characters_long
ADMIN_EMAIL=shivam@hasslefree-travels.com
ADMIN_PASSWORD=change_this_secure_admin_password_2026

# ─── Lead Capture (Required for form submissions to work) ───
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
LEADS_TO_EMAIL=shivam@hasslefree-travels.com

# ─── Telegram Alerts (Optional — sends a Telegram message per lead) ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Analytics & Tracking (Production only) ───
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─── WhatsApp Number (without + prefix, e.g. 918375030889) ───
NEXT_PUBLIC_WHATSAPP_NUMBER=918375030889

# ─── Google Reviews Link (links to your Google Business Profile reviews) ───
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=

